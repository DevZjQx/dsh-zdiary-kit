{
  "name": "dsh-zdiary-kit",
  "version": "0.2.0",
  "description": "内置 zk 的 DSH 知识库 / 日记插件：装好即用 —— 自动装 zk、建笔记本，给 agent 一组 zk_* 工具（搜索、读写、日记、双链），设置页里管路径、索引与自检。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "zk",
    "zettelkasten",
    "notes",
    "journal",
    "diary"
  ],
  "type": "module",
  "main": "dist/app/plugin.js",
  "exports": {
    ".": "./dist/app/plugin.js",
    "./client": "./dist/features/settings/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "zk-kit": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun scripts/postbuild.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun scripts/test.ts",
    "check": "bun run typecheck && bun run build && bun run test",
    "cli": "bun src/cli.ts",
    "smoke": "bun scripts/smoke.ts && bun scripts/docs.ts",
    "docs": "bun scripts/docs.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT"
}
