{
  "name": "dsh-zdiary-kit",
  "version": "0.7.2",
  "description": "内置 zk 的 DSH 知识库 / 日记插件：装好即用 —— 自动装 zk、建笔记本，给 agent 一组 zk_* 工具（搜索、读写、日记、双链），设置页里管路径、索引与自检。",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevZjQx/dsh-zdiary-kit.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "zk",
    "zettelkasten",
    "notes",
    "journal",
    "diary"
  ],
  "type": "module",
  "main": "dist/app/plugin.js",
  "exports": {
    ".": "./dist/app/plugin.js",
    "./client": "./dist/features/settings/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "zk-kit": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs/features",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun scripts/postbuild.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun scripts/test.ts",
    "check": "bun run typecheck && bun run build && bun run check:dist && bun run test",
    "check:dist": "bun scripts/dist-check.ts",
    "cli": "bun src/cli.ts",
    "smoke": "bun scripts/smoke.ts && bun scripts/docs.ts",
    "docs": "bun scripts/docs.ts",
    "version": "bun scripts/sync-version.ts",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT"
}
