# 依赖
node_modules/

# 构建：dist/ 是发布物，必须提交（安装方不编译，见 package.json files）
# 这里只忽略编译器的增量缓存
*.tsbuildinfo

# 日志与临时文件
*.log
tmp/
.tmp/

# 本地环境变量（发布包不需要；示例文件保留）
.env
.env.*
!.env.example

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 插件运行期数据：配置 / 内置 zk 在 ~/.dsh/zdiary，笔记本默认在工作区内（<工作区>/zdiary，
# src/config/paths.ts）。在本仓库里跑插件会生成 ./zdiary —— 那是本地日记本，不入库。
/zdiary/
